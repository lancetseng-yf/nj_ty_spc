<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= __('pps_batch_title') %></title>
    <script src="/libs/echarts/echarts.min.js"></script>
   <link rel="stylesheet" href="/libs/bootstrap/bootstrap.min.css" />
     <link rel="stylesheet" href="/libs/material-icons/material-icons.css" />

    <link rel="stylesheet" href="/css/pps-batch.css">
  </head>
  <body>
    <div class="controls">
      <h1 class="mb-4"><%= __('pps_batch_chart_label') %></h1>

      <!-- Dropdown -->
      <div id="controls">
         <%- include("partials/_product-dropbox") %>

       <%- include("partials/_countdown-control") %>
      </div>

      <div>
        <%- include("partials/_datetimepicker") %>
      </div>
    <!-- Loading Partial -->
    <%- include('partials/loading') %>

    <!-- Chart -->
    <div id="chart"></div>

    <script>
         var i18nLabels = {
        time: "<%= __('time') %>",
        thickness: "<%= __('thickness') %>",
        index: "<%= __('index') %>",
        refresh_time_label: "<%= __('refresh_time_label') %>",
        lasercode: "<%= __('lasercode') %>",
        pressure: "<%= __('pressure') %>",
        speed: "<%= __('speed') %>",
        position: "<%= __('position') %>",
      };
      </script>

 <script src="/js/pps-batch.js"></script>

  </body>
</html>
