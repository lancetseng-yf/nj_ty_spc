<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= __('speed_and_pressure_max_title') %></title>

    <link rel="stylesheet" href="/libs/nouislider/nouislider.min.css" />
    <script src="/libs/echarts/echarts.min.js"></script>
    <script src="/libs/nouislider/nouislider.min.js"></script>
    <script src="/libs/wnumb/wNumb.min.js"></script>
    <link rel="stylesheet" href="/libs/material-icons/material-icons.css" />
    <link rel="stylesheet" href="/libs/bootstrap/bootstrap.min.css" />
    <script src="/libs/bootstrap/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/psmax.css" />
  </head>
  <body>
    <h1><%= __('speed_and_pressure_max_chart_label') %></h1>

    <!-- Loading Spinner -->
    <%- include("partials/loading") %>

    <!-- Main Content (hidden until data loaded) -->
    <div id="main-content" style="display: none">
      <div id="controls">
        <%- include("partials/_product-dropbox") %>
        <%-include("partials/_countdown-control") %>
        <%-include("partials/_hide-manual-control") %>
      </div>
    </div>

    <div class="collapse" id="manual-control">
      <div class="controls"><%- include("partials/_datetimepicker") %></div>
      <div class="controls">
        <table id="limitsTable">
          <thead>
            <tr>
              <th></th>
              <th><%= __('lower_limit') %></th>
              <th><%= __('upper_limit') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b><%= __('max_speed') %></b></td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="speedLCL"
                  value=""
                />
              </td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="speedUCL"
                  value=""
                />
              </td>
              <!-- Merge this cell across 2 rows -->
              <td
                rowspan="2"
                style="text-align: center; vertical-align: middle"
              >
                <button id="applyLimitsBtn"><%= __('update_chart') %></button>
              </td>
            </tr>
            <tr>
              <td><b><%= __('max_pressure') %></b></td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="pressureLCL"
                  value=""
                />
              </td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="pressureUCL"
                  value=""
                />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <!-- statistic data -->
    <div class="controls">
      <table id="statsTable">
        <thead>
          <tr>
            <th><%= __('table_header_product') %></th>
            <th><%= __('table_header_status') %></th>
            <th><%= __('table_header_quantity') %></th>
            <th><%= __('table_header_total') %></th>
            <th><%= __('table_header_percentage') %></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

    <div id="chart"></div>
    <div id="rangeLabel"></div>
    <div id="timeSlider"></div>

    <script>
      var i18nLabels = {
        refresh_time_label: "<%= __('refresh_time_label') %>",
        index: "<%= __('index') %>",
        time: "<%= __('time') %>",
        max_speed: "<%= __('max_speed') %>",
        max_pressure: "<%= __('max_pressure') %>",
        warm_up: "<%= __('warm_up') %>",
        normal_production: "<%= __('normal_production') %>",
      };
    </script>

    <script src="/js/psmax.js"></script>
  </body>
</html>
