
<span>
  <button id="showHelperBtn" class="btn">
    <span class="material-icons">help</span>
  </button>
</span>
<!-- ✅ 使用 modal-xl 讓視窗更大 -->
<div
  class="modal fade"
  id="helperModal"
  tabindex="-1"
  aria-labelledby="helperModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <!-- 包含部分模板 -->
      <%- include("_helper") %>
    </div>
  </div>
</div>

<script src="/libs/bootstrap/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var btnShowHelper = document.getElementById("showHelperBtn");
    var helperModalEl = document.getElementById("helperModal");
    var modal = new bootstrap.Modal(helperModalEl);
    var helperSlide = document.getElementById("helperSlide");

    btnShowHelper.addEventListener("click", function () {
      var slideTo = btnShowHelper.dataset.slide;
      switch (slideTo) {
        case "pps-single":
          helperSlide.innerHTML = `
            <div class="carousel-item active">
            <img src="/images/pps-single/img1.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
            <img src="/images/pps-single/img2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
            <img src="/images/pps-single/img3.jpg" class="d-block w-100" alt="...">
            </div>`;
          break;
        case "pps-batch":
          helperSlide.innerHTML = `
            <div class="carousel-item active">
            <img src="/images/pps-batch/img1.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
            <img src="/images/pps-batch/img2.jpg" class="d-block w-100" alt="...">
            </div>
           `;
          break;
        default:
          helperSlide.innerHTML = `
            <div class="carousel-item active">
               Waiting for content...
            </div>
           `;
          break;
      }

      modal.show();
    });

    helperModalEl.addEventListener("hidden.bs.modal", function () {
      console.log("Modal 已關閉");
    });
  });
</script>
