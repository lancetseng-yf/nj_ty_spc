<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TY Data Visualization Dashboard</title>
    <link rel="stylesheet" href="/libs/bootstrap/bootstrap.min.css" />
    <style>
      body {
        background-color: #f8f9fa;
        padding-top: 50px;
      }
      .card {
        transition: transform 0.2s;
        height: 100%;
      }
      .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      .card-title {
        color: #0d6efd;
        font-weight: bold;
      }
      .header-title {
        margin-bottom: 40px;
        text-align: center;
        color: #343a40;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="header-title">TY Data Visualization System</h1>
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <% routes.forEach(route => { %>
        <div class="col">
          <a href="<%= route.path %>" class="text-decoration-none text-dark">
            <div class="card h-100">
              <div class="card-body text-center d-flex flex-column justify-content-center">
                <h5 class="card-title"><%= route.name %></h5>
                <p class="card-text text-muted"><%= route.description %></p>
                <div class="mt-3">
                  <span class="badge bg-primary rounded-pill">GO</span>
                </div>
              </div>
            </div>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <script src="/libs/bootstrap/bootstrap.bundle.min.js"></script>
  </body>
</html>
