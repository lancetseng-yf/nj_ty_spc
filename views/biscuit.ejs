<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= __('biscuit_title') %></title>
    <script src="/libs/echarts/echarts.min.js"></script>
    <!-- <%= __('') %> -->
    <!-- <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    /> -->
    <link rel="stylesheet" href="/libs/material-icons/material-icons.css" />
    <link rel="stylesheet" href="/libs/bootstrap/bootstrap.min.css" />
    <script src="/libs/bootstrap/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/biscuit.css" />
  </head>
  <body>
    <h1><%= __('biscuit_chart_label') %> <%- include("partials/_helper-control") %></h1>

    <div id="controls">
      <%- include("partials/_product-dropbox") %>
      <%-include("partials/_countdown-control") %>
      <%-include("partials/_hide-manual-control") %>
    </div>

    <div class="collapse" id="manual-control">
      <div class="controls"><%- include("partials/_datetimepicker") %></div>
      <div class="controls">
        <table id="limitsTable">
          <thead>
            <tr>
              <th></th>
              <th><%= __('lower_limit') %></th>
              <th><%= __('upper_limit') %></th>
              <th><%= __('mean') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b><%= __('thickness') %></b></td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="thicknessLCL"
                  value=""
                />
              </td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="thicknessUCL"
                  value=""
                />
              </td>
              <td>
                <input
                  class="form-control"
                  type="number"
                  id="thicknessMean"
                  value=""
                />
              </td>
              <!-- Merge this cell across 2 rows -->
              <td
                rowspan="1"
                style="text-align: center; vertical-align: middle"
              >
                <button id="applyLimitsBtn"><%= __('update_chart') %></button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <!-- Loading Spinner Partial -->
    <%- include("partials/loading") %>

    <!-- Chart Container -->
    <div id="chart" style="height: 500px"></div>

    <script>
      var currentType = "<%= type %>";
      //for translating
      var i18nLabels = {
        normal: "<%= __('normal') %>",
        below: "<%= __('below') %>",
        above: "<%= __('above') %>",
        lower_limit: "<%= __('lower_limit') %>",
        upper_limit: "<%= __('upper_limit') %>",
        mean: "<%= __('mean') %>",
        time: "<%= __('time') %>",
        thickness: "<%= __('thickness') %>",
        index: "<%= __('index') %>",
        thickness_y_label: "<%= __('thickness_y_label') %>",
        refresh_time_label: "<%= __('refresh_time_label') %>",
      };
    </script>
    <script src="/js/biscuit.js"></script>
  </body>
</html>
